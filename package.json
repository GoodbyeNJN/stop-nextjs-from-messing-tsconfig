{
    "name": "stop-nextjs-from-messing-tsconfig",
    "version": "1.0.2",
    "description": "A simple script to stop Next.js from messing with your tsconfig.json file.",
    "keywords": [
        "Next.js",
        "tsconfig"
    ],
    "homepage": "https://github.com/GoodbyeNJN/stop-nextjs-from-messing-tsconfig",
    "bugs": {
        "url": "https://github.com/GoodbyeNJN/stop-nextjs-from-messing-tsconfig/issues"
    },
    "license": "MIT",
    "author": "GoodbyeNJN <cc@fuckwall.cc>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GoodbyeNJN/stop-nextjs-from-messing-tsconfig.git"
    },
    "bin": {
        "stop-nextjs-from-messing-tsconfig": "bin/index.js"
    },
    "files": [
        "bin"
    ],
    "type": "module",
    "scripts": {
        "dev": "rolldown -w -c",
        "build": "rolldown -c",
        "check": "tsgo && oxlint && oxfmt --check",
        "check:type": "tsgo",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt --check",
        "format:write": "oxfmt"
    },
    "dependencies": {
        "package-manager-detector": "^1.6.0"
    },
    "devDependencies": {
        "@goodbyenjn/configs": "^26.5.3",
        "@types/node": "^22.19.19",
        "@typescript/native-preview": "7.0.0-dev.20260518.1",
        "oxfmt": "^0.50.0",
        "oxlint": "^1.65.0",
        "oxlint-tsgolint": "^0.23.0",
        "rolldown": "1.0.1"
    }
}
